# Copy to .env and fill in. NEVER commit .env.

# Telegram bot token from @BotFather (required to run the bot).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- LLM provider for the classifier (Phase 2+) ---
# Which provider get_llm() uses: "cerebras" (default) or "gemini".
LLM_PROVIDER=cerebras

# Cerebras (default). Fast inference, generous free tier.
# Get a key at https://cloud.cerebras.ai  ·  models: https://inference-docs.cerebras.ai/models
# Available models are account-specific — list yours at GET https://api.cerebras.ai/v1/models
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Google Gemini (alternative). Key: https://aistudio.google.com/apikey
# Do NOT use a Gemini 3.x model — it forces temperature=1.0 (breaks reproducibility).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (other providers kept for reference; not used by the current classifier)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: override the SQLite store location (defaults to data/accounting.db).
# DB_PATH=
