# Copy to .env and fill in. NEVER commit .env.

# Telegram bot token from @BotFather (required to run the bot).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# LLM key — only ONE is needed, used from Phase 2 onward for classification + Q&A.
# Phase 1 uses a temporary rule-based classifier and needs neither.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: override the SQLite store location (defaults to data/accounting.db).
# DB_PATH=
